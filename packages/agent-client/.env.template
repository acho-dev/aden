# LLM API Keys (Required based on provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

# Aden Authentication (Required for team features)
ADEN_JWT_TOKEN=
ADEN_HOST=https://kube.acho.io

# LLM Settings (Optional - defaults in config.json)
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# MCP Settings (Optional)
MCP_SERVER_PATH=../mcp-server/src/index.js
MCP_TIMEOUT=60000

# Agent Execution Settings (Optional)
AGENT_MAX_ITERATIONS=10
AGENT_MAX_REPLANS=3
AGENT_MAX_TASKS=15
AGENT_NO_PROGRESS_THRESHOLD=3
AGENT_MAX_TOOL_CALLS=25

# Agent Retry Settings (Optional)
AGENT_MAX_VALIDATION_RETRIES=3
AGENT_MAX_OPTIMIZER_RETRIES=2

# Agent Limits (Optional)
AGENT_MAX_CONTENT_LENGTH=15000
AGENT_MEMORY_SEARCH_LIMIT=5
AGENT_RECENT_HISTORY_LIMIT=10

# Agent Timeouts (Optional - in milliseconds)
AGENT_FORCE_EXIT_TIMEOUT=15000
AGENT_MCP_TOOL_TIMEOUT=15000
AGENT_API_TIMEOUT=20000

# Logging Settings (Optional)
LOG_LEVEL=info
CONVERSATION_LOGGING_ENABLED=true
CONVERSATION_LOG_DIR=./logs
CONVERSATION_MAX_LOG_FILE_SIZE=10485760
CONVERSATION_MAX_LOG_FILES=50

# CLI Settings (Optional)
CLI_HISTORY_SIZE=100
CLI_COLOR_OUTPUT=true